{
  "meta": {
    "name": "Dumbbill design tokens",
    "version": "1.0.0",
    "about": "The single source of truth for colours, type, shape and motion. Web (dumbbill-web) and mobile (dumbbill-mobile, from P0-6) both GENERATE their code from this file. Edit here, then run `pnpm tokens` in the web app. Never edit the generated files.",
    "themes": { "dark": "Iron Ledger", "light": "Quiet Ledger" },
    "decision": "docs/02-design/design-guide.md section 0"
  },

  "color": {
    "roles": {
      "bg.base": { "tailwind": "base", "use": "Page background." },
      "bg.surface": { "tailwind": "surface", "use": "Cards, inputs, table bodies, menus." },
      "bg.side": { "tailwind": "side", "use": "Side panels and the POS totals column." },
      "bg.hover": { "tailwind": "hover", "use": "Row and item hover background." },
      "border": { "tailwind": "line", "use": "Hairlines between rows and around cards. Decorative: never the only way to see a control." },
      "border.strong": { "tailwind": "rule", "use": "The hard 2px rule under table headers and above KPI strips." },
      "border.control": { "tailwind": "control", "use": "Edges of inputs, selects, checkboxes and secondary buttons. Must be 3:1 against the surface (WCAG 1.4.11)." },
      "text": { "tailwind": "ink", "use": "Body text and headings." },
      "text.muted": { "tailwind": "muted", "use": "Secondary text, captions, placeholders." },
      "accent": { "tailwind": "accent", "use": "Primary actions and the one thing to look at on a screen." },
      "accent.hover": { "tailwind": "accent-hover", "use": "Primary action while hovered." },
      "accent.on": { "tailwind": "on-accent", "use": "Text and icons drawn on top of the accent colour." },
      "tag.bg": { "tailwind": "tag", "use": "Background of warning-style tags such as expiring soon." },
      "tag.text": { "tailwind": "on-tag", "use": "Text on a tag." },
      "success": { "tailwind": "success", "use": "Positive status." },
      "success.on": { "tailwind": "on-success", "use": "Text drawn on top of the success colour." },
      "danger": { "tailwind": "danger", "use": "Errors and destructive actions." },
      "danger.hover": { "tailwind": "danger-hover", "use": "Destructive action while hovered." },
      "danger.on": { "tailwind": "on-danger", "use": "Text drawn on top of the danger colour." },
      "focus.ring": { "tailwind": "focus", "use": "Keyboard focus outline." },
      "overlay": { "tailwind": "overlay", "use": "Dim layer behind dialogs." },
      "qr.ink": { "tailwind": "qr-ink", "use": "The dark squares of a QR code. The SAME in both themes: scanners need dark squares on a light ground." },
      "qr.paper": { "tailwind": "qr-paper", "use": "The light ground and quiet border of a QR code. The SAME in both themes." }
    },

    "dark": {
      "bg.base": "#0e0f11",
      "bg.surface": "#16181b",
      "bg.side": "#121316",
      "bg.hover": "#1d2024",
      "border": "#2a2d31",
      "border.strong": "#eceae4",
      "border.control": "#6b7075",
      "text": "#eceae4",
      "text.muted": "#8d9096",
      "accent": "#c6f432",
      "accent.hover": "#d4ff4d",
      "accent.on": "#0e0f11",
      "tag.bg": "#2a2d31",
      "tag.text": "#c6f432",
      "success": "#4ddc8e",
      "success.on": "#0e0f11",
      "danger": "#ff6a45",
      "danger.hover": "#ff8466",
      "danger.on": "#0e0f11",
      "focus.ring": "#c6f432",
      "overlay": "rgba(0, 0, 0, 0.65)",
      "qr.ink": "#0e0f11",
      "qr.paper": "#fbfaf8"
    },

    "light": {
      "bg.base": "#fbfaf8",
      "bg.surface": "#ffffff",
      "bg.side": "#f4f2ed",
      "bg.hover": "#efece5",
      "border": "#e3dfd6",
      "border.strong": "#8a857a",
      "border.control": "#858a90",
      "text": "#1b1f23",
      "text.muted": "#5f646a",
      "accent": "#0f5c5c",
      "accent.hover": "#0b4a4a",
      "accent.on": "#ffffff",
      "tag.bg": "#fdf0d9",
      "tag.text": "#8a5a10",
      "success": "#1d7a4f",
      "success.on": "#ffffff",
      "danger": "#b4402b",
      "danger.hover": "#963422",
      "danger.on": "#ffffff",
      "focus.ring": "#0f5c5c",
      "overlay": "rgba(27, 31, 35, 0.5)",
      "qr.ink": "#0e0f11",
      "qr.paper": "#fbfaf8"
    }
  },

  "contrast": [
    { "fg": "text", "bg": "bg.base", "min": 4.5, "use": "Body text on the page" },
    { "fg": "text", "bg": "bg.surface", "min": 4.5, "use": "Body text on cards and inputs" },
    { "fg": "text", "bg": "bg.side", "min": 4.5, "use": "Body text on side panels" },
    { "fg": "text", "bg": "bg.hover", "min": 4.5, "use": "Body text on a hovered row" },
    { "fg": "text.muted", "bg": "bg.base", "min": 4.5, "use": "Secondary text on the page" },
    { "fg": "text.muted", "bg": "bg.surface", "min": 4.5, "use": "Secondary text and placeholders on cards and inputs" },
    { "fg": "text.muted", "bg": "bg.side", "min": 4.5, "use": "Secondary text on side panels" },
    { "fg": "text.muted", "bg": "bg.hover", "min": 4.5, "use": "Secondary text on a hovered row" },
    { "fg": "accent", "bg": "bg.base", "min": 4.5, "use": "Accent used as text or icon on the page" },
    { "fg": "accent", "bg": "bg.surface", "min": 4.5, "use": "Accent used as text or icon on cards" },
    { "fg": "accent.on", "bg": "accent", "min": 4.5, "use": "Primary button label" },
    { "fg": "accent.on", "bg": "accent.hover", "min": 4.5, "use": "Primary button label while hovered" },
    { "fg": "tag.text", "bg": "tag.bg", "min": 4.5, "use": "Tag label" },
    { "fg": "success", "bg": "bg.base", "min": 4.5, "use": "Success text on the page" },
    { "fg": "success", "bg": "bg.surface", "min": 4.5, "use": "Success text on cards" },
    { "fg": "success.on", "bg": "success", "min": 4.5, "use": "Text on a success fill" },
    { "fg": "danger", "bg": "bg.base", "min": 4.5, "use": "Error text on the page" },
    { "fg": "danger", "bg": "bg.surface", "min": 4.5, "use": "Error text on cards and inputs" },
    { "fg": "danger.on", "bg": "danger", "min": 4.5, "use": "Destructive button label" },
    { "fg": "danger.on", "bg": "danger.hover", "min": 4.5, "use": "Destructive button label while hovered" },
    { "fg": "border.control", "bg": "bg.base", "min": 3, "use": "Control edge on the page (non-text, WCAG 1.4.11)" },
    { "fg": "border.control", "bg": "bg.surface", "min": 3, "use": "Control edge on cards" },
    { "fg": "border.control", "bg": "bg.side", "min": 3, "use": "Control edge on side panels" },
    { "fg": "focus.ring", "bg": "bg.base", "min": 3, "use": "Focus outline on the page (non-text)" },
    { "fg": "focus.ring", "bg": "bg.surface", "min": 3, "use": "Focus outline on cards" },
    { "fg": "focus.ring", "bg": "bg.side", "min": 3, "use": "Focus outline on side panels" },
    { "fg": "border.strong", "bg": "bg.base", "min": 3, "use": "The hard rule under table headers (kept visible in both themes)" },
    { "fg": "qr.ink", "bg": "qr.paper", "min": 7, "use": "QR code squares on their ground (must scan reliably)" }
  ],
  "contrastNotRequired": {
    "overlay": "A translucent dim layer, never used for text.",
    "border": "Decorative hairline. Controls use border.control instead.",
    "bg.hover": "Only ever used as a background; covered through the text pairs above."
  },

  "font": {
    "ui": { "family": "Inter Tight", "fallback": "system-ui, sans-serif", "use": "Interface text" },
    "numerals": { "family": "Barlow Condensed", "fallback": "'Arial Narrow', sans-serif", "use": "Totals, big numbers, headings" },
    "code": { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace", "use": "Prices in tables, SKUs, barcodes" }
  },
  "fontSize": {
    "micro": 11,
    "caption": 12,
    "small": 14,
    "body": 16,
    "title": 20,
    "heading": 28,
    "display": 40,
    "hero": 64
  },
  "radius": { "control": 4, "card": 8 },
  "focus": { "width": 2, "offset": 2 },
  "size": {
    "controlSm": 32,
    "controlMd": 40,
    "controlLg": 48,
    "rowCompact": 32,
    "rowComfortable": 44
  },
  "motion": {
    "duration": { "micro": 100, "base": 180, "large": 280, "page": 360 },
    "easing": {
      "enter": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "shift": 8
  }
}
