NODE_ENV=development
PORT=3000
BRAND_NAME=Dumbbill
LOG_LEVEL=debug
# --- Database: TWO connections on purpose (see docs/adr/002-prisma-rls.md) ---
# OWNER: creates tables, runs migrations and seeds. Used by tooling only, NOT by the running API in production.
DATABASE_URL=postgresql://dumbbill:dumbbill@localhost:5432/dumbbill?schema=public
# APP: what the running API connects as. Restricted role: cannot change structure and cannot bypass
# row-level security. Created by `pnpm db:roles` (also run by db:migrate / db:deploy).
APP_DATABASE_URL=postgresql://dumbbill_app:dumbbill_app@localhost:5432/dumbbill?schema=public
REDIS_URL=redis://localhost:6379
# Error tracking: leave empty to switch Sentry off (nothing is sent anywhere).
SENTRY_DSN=
# Written on every log line and Sentry report. Set to the release (for example the git tag) when deploying.
APP_VERSION=dev
# Tracing: none = off (default). console = print every span to the terminal, useful for debugging slow requests.
OTEL_EXPORTER=none

# --- File storage ---
# Uploaded files are saved on this server's disk. Back this folder up together with the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_FILE_MB=5

# --- Sign-in and security (see docs/adr/006-auth-and-sessions.md) ---
# In development every secret below may stay empty: safe throw-away values are used and a warning is logged.
# In PRODUCTION they are REQUIRED and the app refuses to start without them (create them with `pnpm keys:generate`).
#
# Where the web app lives (used in the links inside emails) and which browser origins may call the API.
WEB_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Shared cookie domain when the web app and API are on different subdomains (for example .dumbbill.in). Empty in development.
COOKIE_DOMAIN=
# How many proxies (load balancer, CDN) sit in front of the API. 0 = none. Set it exactly: it decides which IP address is trusted.
TRUST_PROXY_HOPS=0
# Signs access tokens. Empty = a throw-away key is created at start-up (development only).
JWT_KEY_ID=dev
JWT_PRIVATE_KEY=
# Old public keys still accepted while a key is being rotated: kid:base64(public PEM), comma separated.
JWT_PREVIOUS_PUBLIC_KEYS=
# Server-side password secret, `version:secret` pairs. Empty = a development value is used.
PASSWORD_PEPPERS=
# Password hashing strength (Argon2id). Production floor: 19456 KiB. Do not lower these in production.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
# Refuse passwords found in known data breaches (only a 5-character hash prefix leaves the server). Skipped if the service is unreachable.
PASSWORD_BREACH_CHECK=true
# Encrypts authenticator-app secrets. Empty = a development key is used.
DATA_ENCRYPTION_KEY=

# --- Email ---
# Development: Mailpit (started by docker compose) catches every email; read them at http://localhost:8025.
# Production: Amazon SES SMTP endpoint, for example smtps://USER:PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM=Dumbbill <no-reply@dumbbill.local>

# DEVELOPMENT ONLY: true switches off all rate limits and the wrong-password lockout, so repeated testing is never
# blocked. Production refuses to start with it on.
RATE_LIMIT_DISABLED=false
