NODE_ENV=development
PORT=3000
BRAND_NAME=Dumbbill
LOG_LEVEL=debug
# App connects as a restricted role (no BYPASSRLS). The owner/migrator URL is added in P0-2.
DATABASE_URL=postgresql://dumbbill:dumbbill@localhost:5432/dumbbill?schema=public
REDIS_URL=redis://localhost:6379
SENTRY_DSN=

# --- File storage ---
# Uploaded files are saved on this server's disk. Back this folder up together with the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_FILE_MB=5
