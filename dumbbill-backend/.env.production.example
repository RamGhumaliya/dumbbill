# Template for the PRODUCTION environment. Copy the keys into the real server's environment
# (or a private .env on the server). NEVER commit real values.
NODE_ENV=production
PORT=3000
BRAND_NAME=Dumbbill
LOG_LEVEL=info
# --- Database: TWO connections on purpose (see docs/adr/002-prisma-rls.md) ---
# OWNER: creates tables, runs migrations and seeds. Used by tooling only, NOT by the running API in production.
DATABASE_URL=postgresql://dumbbill_owner:CHANGE_ME_TOO@db-host:5432/dumbbill?schema=public
# APP: what the running API connects as. Restricted role: cannot change structure and cannot bypass
# row-level security. Created by `pnpm db:roles` (also run by db:migrate / db:deploy).
APP_DATABASE_URL=postgresql://dumbbill_app:CHANGE_ME_LONG_RANDOM@db-host:5432/dumbbill?schema=public
REDIS_URL=redis://redis-host:6379
# Error tracking: leave empty to switch Sentry off (nothing is sent anywhere).
SENTRY_DSN=
# Written on every log line and Sentry report. Set to the release (for example the git tag) when deploying.
APP_VERSION=1.0.0
# Tracing: none = off (default). console = print every span to the terminal, useful for debugging slow requests.
OTEL_EXPORTER=none
# Absolute path on the server. Back this folder up together with the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/dumbbill/storage
STORAGE_MAX_FILE_MB=5
