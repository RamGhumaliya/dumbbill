{
  "name": "dumbbill-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dumbbill API: multi-tenant SaaS backend for protein and supplement retailers",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:sec": "jest --selectProjects security --runInBand",
    "test:all": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/setup-db-roles.mjs && prisma migrate dev",
    "db:deploy": "node scripts/setup-db-roles.mjs && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "prisma db seed -- --group demo",
    "db:seed:list": "prisma db seed -- --list",
    "db:reset": "node scripts/assert-not-production.mjs && prisma migrate reset --force && node scripts/setup-db-roles.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "cd .. && husky dumbbill-backend/.husky",
    "db:roles": "node scripts/setup-db-roles.mjs",
    "docs:errors": "tsx scripts/generate-error-codes.ts",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "esbuild"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.70.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.1.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
