// Dumbbill database schema.
//
// Conventions (see docs/README.md):
//  - Money is stored as whole paise in BigInt columns (Rs 1 = 100 paise). Never floats.
//  - Ids are UUIDs (v7 on tenant tables, generated by Prisma; the small reference tables use the database default).
//  - Tables are snake_case in the database (@@map / @map); models are PascalCase in code.
//
// Two kinds of tables:
//  1. REFERENCE tables (plans, gst_states, category_templates): shared by every business, no tenant_id,
//     filled by the seed system (prisma/seed).
//  2. TENANT tables (tenants, users, and everything added later): every row belongs to one business and is
//     protected by PostgreSQL row-level security (RLS). A new tenant table MUST have a tenant_id column and
//     its migration MUST call enable_tenant_rls('<table>') and app_grant_defaults(). Tests fail if not.
//     See docs/adr/002-prisma-rls.md.
//
// Ids of tenant tables are UUIDv7 (time-ordered, so indexes stay compact), generated by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A subscription plan a retailer can be on (Starter / Growth / Pro). Limits are enforced by the API.
model Plan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine name used in code and webhooks, for example "STARTER". Never changes.
  code              String   @unique
  /// Name shown to customers. Can be renamed freely.
  name              String
  maxBranches       Int      @map("max_branches")
  maxUsers          Int      @map("max_users")
  trialDays         Int      @default(14) @map("trial_days")
  /// Price per month in paise. Null until the owner decides pricing.
  priceMonthlyPaise BigInt?  @map("price_monthly_paise")
  /// Price per year in paise. Null until the owner decides pricing.
  priceYearlyPaise  BigInt?  @map("price_yearly_paise")
  /// Inactive plans stay for existing subscribers but cannot be chosen by new ones.
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenants           Tenant[]

  @@map("plans")
}

/// Indian states and union territories with their official GST state codes.
/// Used to decide CGST+SGST (same state) versus IGST (different state) on an invoice.
model GstState {
  /// Two-digit GST state code, for example "27" for Maharashtra. Kept as text to preserve leading zeros.
  code             String  @id @db.VarChar(2)
  name             String
  isUnionTerritory Boolean @default(false) @map("is_union_territory")

  @@map("gst_states")
}

/// Starter product categories copied into a business when it signs up, so shops do not start empty.
/// The business can rename, edit or delete its own copies; these templates are never shown directly.
model CategoryTemplate {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String @unique
  name             String
  /// Suggested HSN code for products in this category. A suggestion only: the retailer's CA decides.
  defaultHsn       String @map("default_hsn")
  /// Suggested GST rate in basis points (1800 = 18.00%). A suggestion only: the retailer's CA decides.
  defaultGstRateBp Int    @map("default_gst_rate_bp")
  sortOrder        Int    @default(0) @map("sort_order")

  @@map("category_templates")
}

// ---------------------------------------------------------------------------------------------
// TENANT TABLES
// ---------------------------------------------------------------------------------------------

/// Lifecycle of a retailer's account.
enum TenantStatus {
  /// Inside the free trial.
  TRIAL
  /// Paying and in good standing.
  ACTIVE
  /// Payment failed or suspended by us: the POS becomes read-only, data is kept.
  SUSPENDED
  /// Cancelled by the retailer. Data is kept for the export window, then deleted.
  CANCELLED
}

/// One retailer business (a "tenant"). Everything else in the system belongs to exactly one tenant.
/// RLS rule for this table: a request may only see the tenant whose id equals app.tenant_id.
model Tenant {
  id             String            @id @default(uuid(7)) @db.Uuid
  name           String
  status         TenantStatus      @default(TRIAL)
  /// The plan the business is on. Null only briefly during signup.
  planId         String?           @map("plan_id") @db.Uuid
  plan           Plan?             @relation(fields: [planId], references: [id])
  /// When the free trial ends (signup time + the plan's trial days). Billing (Phase 4) acts on it.
  trialEndsAt    DateTime?         @map("trial_ends_at") @db.Timestamptz()
  /// Business profile (P1-3). GSTIN is optional: a shop not registered for GST issues bills of supply, not tax invoices.
  gstin          String?           @db.VarChar(15)
  /// Two-digit GST state code of the registered address; decides CGST+SGST (same state) vs IGST (other state).
  stateCode      String?           @map("state_code") @db.VarChar(2)
  addressLine    String?           @map("address_line")
  city           String?
  pincode        String?           @db.VarChar(6)
  phone          String?           @db.VarChar(15)
  /// Storage key of the logo image (never a public URL; the API streams it to signed-in people).
  logoKey        String?           @map("logo_key")
  /// How many days before a batch's expiry date it shows up as "near expiry" in the stock alerts (P1-5).
  nearExpiryDays Int               @default(60) @map("near_expiry_days")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  users          User[]
  sessions       Session[]
  roles          Role[]
  branches       Branch[]
  categories     ProductCategory[]
  products       Product[]

  @@map("tenants")
}

/// Whether a staff member can log in.
enum UserStatus {
  /// Invited by the owner but has not set a password yet.
  INVITED
  ACTIVE
  /// Access removed. All sessions are revoked when this is set.
  DISABLED
}

/// A staff member (owner, admin or cashier) of one business. Customers are a separate, global table (Phase 3).
/// Roles and permissions are added in P1-2.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Always lowercase (enforced by a CHECK constraint). Unique across ALL businesses, so one email means one account.
  email        String     @unique
  /// Argon2id hash. Null until an invited user sets a password. Never returned by any API.
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  /// Who created this row (a user id), for the audit trail. Null for the first owner created at signup.
  createdBy    String?    @map("created_by") @db.Uuid

  // --- Authentication (P1-1). None of these columns is ever returned by an API. ---
  /// When the person proved they own the email address. Login is refused until this is set.
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz()
  /// True for the person who created the business. Roles and permissions arrive in P1-2.
  isOwner            Boolean   @default(false) @map("is_owner")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz()
  /// The TOTP (authenticator app) secret, ENCRYPTED with the server's data key. Null = two-step login is off or not finished.
  totpSecretEnc      String?   @map("totp_secret_enc")
  /// Set when the person confirmed their first code. Two-step login is on only when this is set.
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz()
  /// Time-step number of the last accepted code, so the same code cannot be used twice.
  totpLastStep       BigInt?   @map("totp_last_step")
  /// SHA-256 hashes of the unused one-time recovery codes.
  totpRecoveryHashes String[]  @default([]) @map("totp_recovery_hashes")

  // --- Team and permissions (P1-2) ---
  /// The role template this person works under (Owner, Admin, Cashier or a custom one). Null only for rows created before P1-2.
  roleId            String?      @map("role_id") @db.Uuid
  role              Role?        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Permissions granted to this person ON TOP of their role (the owner picks them one by one).
  extraPermissions  String[]     @default([]) @map("extra_permissions")
  /// Permissions taken away from this person even though their role has them. Wins over everything else.
  deniedPermissions String[]     @default([]) @map("denied_permissions")
  /// This person's own discount limit in basis points (500 = 5%). Null = use the role's limit.
  discountLimitBp   Int?         @map("discount_limit_bp")
  /// Hash of the 6-digit approval PIN (peppered Argon2id). Never returned by any API.
  pinHash           String?      @map("pin_hash")
  pinSetAt          DateTime?    @map("pin_set_at") @db.Timestamptz()
  /// When access was removed, and by whom. Cleared if the person is switched back on.
  disabledAt        DateTime?    @map("disabled_at") @db.Timestamptz()
  disabledBy        String?      @map("disabled_by") @db.Uuid
  branches          UserBranch[]

  sessions   Session[]
  authTokens AuthToken[]

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------------------------
// AUTHENTICATION TABLES (P1-1). All are tenant tables: the tenant id is carried inside every token
// we hand out, so a request can be pointed at the right business BEFORE anything is read.
// See docs/adr/006-auth-and-sessions.md.
// ---------------------------------------------------------------------------------------------

/// One sign-in on one device. Revoking a session stops its refresh tokens working at once.
model Session {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WEB (refresh token in an httpOnly cookie) or MOBILE (refresh token kept by the app).
  clientType    String         @map("client_type")
  /// A short human label such as "Chrome on Windows", built from the User-Agent. Shown in the session list.
  deviceLabel   String         @map("device_label")
  /// The IP address of the sign-in, shown to the user so they can spot a stranger.
  ipAddress     String?        @map("ip_address")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt    DateTime       @default(now()) @map("last_used_at") @db.Timestamptz()
  /// Set when the session is ended (logout, revoked, password changed, token reuse detected).
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz()
  /// Why it was ended: LOGOUT, REVOKED_BY_USER, PASSWORD_CHANGED, PASSWORD_RESET, TOKEN_REUSE.
  revokedReason String?        @map("revoked_reason")
  refreshTokens RefreshToken[]

  @@index([tenantId, userId])
  @@map("sessions")
}

/// One refresh token of a session. Only a hash is stored. Each token is used once and replaced by the next
/// (rotation); presenting an already-used token means it was stolen, and the whole session is ended.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SHA-256 of the secret part of the token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// 30 days after it was issued (the "sliding" window: every rotation issues a new one).
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  /// Set the first time the token is exchanged for a new one.
  usedAt    DateTime? @map("used_at") @db.Timestamptz()

  @@index([tenantId, sessionId])
  @@map("refresh_tokens")
}

/// Why a one-time emailed token exists.
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// The link in a team invitation email: lets the invited person choose a password.
  INVITATION
}

/// A single-use token sent by email (verify the address, reset the password). Only a hash is stored.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  /// Verification links last 24 hours, password reset links 30 minutes.
  expiresAt DateTime         @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?        @map("used_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, userId, purpose])
  @@map("auth_tokens")
}

/// The business record of who did what (hard rule 7). APPEND-ONLY: the app role cannot UPDATE or DELETE rows.
/// This is evidence, unlike logs, which expire. Never put secrets or full personal data in `metadata`.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The staff member who did it. Null for system actions.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// A dotted event name such as "auth.login", "auth.password_changed".
  action      String
  /// What it was done to (for example "session") and its id.
  entity      String?
  entityId    String?  @map("entity_id")
  /// Small extra facts (for example the reason a session ended). No secrets.
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  /// The request id, so the audit row can be matched to the log lines of the same request.
  requestId   String?  @map("request_id")
  /// The role the person held when they did it (roles can be renamed later, so the name is kept as it was).
  actorRole   String?  @map("actor_role")
  /// The state of the thing before and after the change, for events where that matters (a stock adjustment).
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// TEAM, ROLES AND BRANCHES (P1-2)
// ---------------------------------------------------------------------------------------------

/// A role template: a named bundle of permissions ("Cashier"). Every business gets Owner, Admin and Cashier at
/// signup and may edit the Admin and Cashier ones, or add its own. The OWNER role is locked: the owner always has
/// every permission, so nobody can lock themselves out of their own business.
/// Permission keys come from src/modules/permissions/permissions.matrix.ts (the single source of truth).
model Role {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  description     String   @default("")
  /// OWNER, ADMIN or CASHIER for the three built-in templates; null for roles the business created itself.
  systemKey       String?  @map("system_key")
  /// The permission keys this role grants.
  permissions     String[] @default([])
  /// The biggest discount this role may give on its own, in basis points (500 = 5%). Above it, a manager approves.
  discountLimitBp Int      @default(0) @map("discount_limit_bp")
  /// True when people in this role may work in every branch; otherwise only the branches assigned to them.
  allBranches     Boolean  @default(false) @map("all_branches")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  users           User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// A shop location of a business. P1-2 only needs the bare minimum (so staff can be assigned to branches); P1-3
/// adds address, GST number, invoice prefix, printer settings and the screens to manage them.
model Branch {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  isActive       Boolean       @default(true) @map("is_active")
  addressLine    String?       @map("address_line")
  city           String?
  pincode        String?       @db.VarChar(6)
  phone          String?       @db.VarChar(15)
  /// GST state of THIS shop. Tax logic compares it with the customer's state (place of supply).
  stateCode      String?       @map("state_code") @db.VarChar(2)
  /// A branch in another state has its own GSTIN; it must start with the branch's state code.
  gstin          String?       @db.VarChar(15)
  /// Letters and digits printed at the start of every invoice number of this branch, for example "FF". Unique per business.
  invoicePrefix  String        @map("invoice_prefix") @db.VarChar(6)
  /// Receipt paper width: 58 or 80 mm.
  printerWidthMm Int           @default(80) @map("printer_width_mm")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  users          UserBranch[]
  purchases      Purchase[]
  stockLevels    StockLevel[]
  stockLedgers   StockLedger[]
  stockBatchs    StockBatch[]

  @@unique([tenantId, name])
  @@unique([tenantId, invoicePrefix])
  @@index([tenantId])
  @@map("branches")
}

/// Which branches a person may work in (only used when their role is not "all branches").
model UserBranch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([userId, branchId])
  @@index([tenantId, branchId])
  @@map("user_branches")
}

/// A product category of ONE business (for example "Protein & whey"). New businesses start with a copy of the
/// category templates; the owner can add more. HSN and GST here are suggestions that pre-fill the product form.
model ProductCategory {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name             String
  defaultHsn       String?   @map("default_hsn") @db.VarChar(8)
  defaultGstRateBp Int?      @map("default_gst_rate_bp")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  products         Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

/// One sellable item. A VARIANT (2 kg / Chocolate) is its own row with its own barcode and price, sharing the name
/// and brand with its siblings. Products are switched off, never deleted: invoices and stock will refer to them.
/// There is no price column: prices live in `price_history` (effective-dated), so a bill always uses the price that
/// was valid at bill time.
model Product {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name              String
  brand             String           @default("")
  categoryId        String?          @map("category_id") @db.Uuid
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// For example "2 kg / Chocolate". Empty for a product with no variants.
  variant           String           @default("")
  sku               String?
  /// The code printed on the pack (EAN-13 and similar). Unique inside a business.
  barcode           String?
  /// HSN: the goods classification code (4, 6 or 8 digits) printed on a tax invoice. Required when the business has a GSTIN.
  hsn               String?          @db.VarChar(8)
  /// GST rate in basis points (1800 = 18.00%).
  gstRateBp         Int?             @map("gst_rate_bp")
  /// What the owner says the item costs, entered by hand. CONFIDENTIAL: only people with products.cost.read see or set it.
  /// Purchases and weighted average cost (P1-5) will supersede it for profit figures.
  purchaseCostPaise Int?             @map("purchase_cost_paise")
  imageKey          String?          @map("image_key")
  thumbKey          String?          @map("thumb_key")
  isActive          Boolean          @default(true) @map("is_active")
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  prices            PriceHistory[]
  stockLevels       StockLevel[]
  stockLedgers      StockLedger[]
  stockBatchs       StockBatch[]
  purchaseLines     PurchaseLine[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
  @@unique([tenantId, name, brand, variant])
  @@index([tenantId, categoryId])
  @@map("products")
}

/// Every selling price a product ever had. APPEND-ONLY: a price change adds a row; nothing is edited or deleted, so the
/// history is a trustworthy record of who changed what, when and why. The price in force is the newest row whose
/// `effective_from` is not in the future.
model PriceHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Maximum retail price printed on the pack, in paise. The law forbids selling above it.
  mrpPaise      Int      @map("mrp_paise")
  /// What this business sells it for, in paise.
  pricePaise    Int      @map("price_paise")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz()
  changedBy     String?  @map("changed_by") @db.Uuid
  reason        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, productId, effectiveFrom(sort: Desc)])
  @@map("price_history")
}

// ---------------------------------------------------------------------------------------------
// SUPPLIERS, PURCHASES, STOCK (P1-5)
// ---------------------------------------------------------------------------------------------

/// Why stock moved. Every movement is one row of the append-only stock ledger.
enum LedgerType {
  /// Goods received from a supplier (a purchase).
  PURCHASE
  /// Sold at the till (written by the POS in Phase 2).
  SALE
  /// A customer brought goods back (Phase 2): restocked at the cost they were sold at.
  SALE_RETURN
  /// A recount found MORE than the books say.
  ADJUSTMENT_IN
  /// A recount, damage or loss: LESS than the books say.
  ADJUSTMENT_OUT
  /// Left this branch for another (in transit).
  TRANSFER_OUT
  /// Arrived at this branch from another.
  TRANSFER_IN
  /// A transfer that was cancelled in transit: the goods go back to the sending branch.
  TRANSFER_CANCEL
  /// Goods sent back to the supplier (a debit note).
  SUPPLIER_RETURN
  /// Expired goods written off.
  EXPIRY_WRITE_OFF
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/// A business a shop buys from.
model Supplier {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  gstin       String?          @db.VarChar(15)
  phone       String?          @db.VarChar(15)
  email       String?
  addressLine String?          @map("address_line")
  city        String?
  notes       String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  purchases   Purchase[]
  returns     SupplierReturn[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

/// A supplier's bill, entered when the goods arrive. IMMUTABLE once saved: a mistake is corrected with a supplier
/// return or an adjustment, never by editing the purchase (the ledger it created is append-only too).
model Purchase {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId     String         @map("supplier_id") @db.Uuid
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The supplier's own invoice number. Unique per supplier, so the same bill cannot be entered twice.
  invoiceRef     String         @map("invoice_ref")
  invoiceDate    DateTime       @map("invoice_date") @db.Date
  /// Freight and other extra costs on the bill, in paise. Spread over the lines in proportion to their value.
  otherCostPaise Int            @default(0) @map("other_cost_paise")
  /// Sum of qty x unit cost over the lines, before the extra costs.
  subtotalPaise  Int            @map("subtotal_paise")
  /// Subtotal plus extra costs: what the supplier is owed for this bill.
  totalPaise     Int            @map("total_paise")
  note           String?
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  lines          PurchaseLine[]

  @@unique([tenantId, supplierId, invoiceRef])
  @@index([tenantId, createdAt])
  @@map("purchases")
}

model PurchaseLine {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  purchaseId         String    @map("purchase_id") @db.Uuid
  purchase           Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productId          String    @map("product_id") @db.Uuid
  product            Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty                Int
  /// What the supplier charges per unit, in paise.
  unitCostPaise      Int       @map("unit_cost_paise")
  /// This line's share of the extra costs, in paise (the shares add up exactly to the bill's extra cost).
  allocatedCostPaise Int       @map("allocated_cost_paise")
  /// qty x unit cost + allocated extra cost: what these units really cost the shop, landed.
  lineTotalPaise     Int       @map("line_total_paise")
  batchId            String?   @map("batch_id") @db.Uuid
  batchNo            String?   @map("batch_no")
  expiryDate         DateTime? @map("expiry_date") @db.Date

  @@index([tenantId, purchaseId])
  @@index([tenantId, productId])
  @@map("purchase_lines")
}

/// A lot of one product at one branch, tracked for its expiry date. Costing is NOT per batch (it is one weighted average
/// per product and branch); batches exist so expiry can be watched and so the oldest stock is used first.
model StockBatch {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId    String    @map("product_id") @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchNo      String?   @map("batch_no")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  qtyRemaining Int       @map("qty_remaining")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, branchId, productId])
  @@index([tenantId, expiryDate])
  @@map("stock_batches")
}

/// How much of a product a branch holds, and what that stock is worth: a PROJECTION of the ledger (always equal to the sum
/// of its rows; a test and a check endpoint prove it). The weighted average cost is value / qty.
model StockLevel {
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty        Int
  /// Total value of the stock on hand in paise. Stored as a total (not a per-unit cost) so no rounding error builds up.
  valuePaise BigInt   @map("value_paise")
  /// Bumped on every change; lets a screen notice that someone else changed the stock.
  version    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([branchId, productId])
  @@index([tenantId])
  @@map("stock_levels")
}

/// Every stock movement ever made. APPEND-ONLY: stock on hand is the sum of this table; corrections are new rows.
model StockLedger {
  id              String     @id @default(uuid(7)) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  branchId        String     @map("branch_id") @db.Uuid
  branch          Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId       String     @map("product_id") @db.Uuid
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId         String?    @map("batch_id") @db.Uuid
  type            LedgerType
  /// Units added (positive) or removed (negative).
  qtyDelta        Int        @map("qty_delta")
  /// Value added (positive) or removed (negative), in paise. Sums to the stock level's value.
  valueDeltaPaise BigInt     @map("value_delta_paise")
  /// The cost of one unit in this movement (value / qty, rounded), for display. CONFIDENTIAL.
  unitCostPaise   Int        @map("unit_cost_paise")
  qtyAfter        Int        @map("qty_after")
  valueAfterPaise BigInt     @map("value_after_paise")
  /// The weighted average cost per unit after this movement, rounded. CONFIDENTIAL.
  wacAfterPaise   Int        @map("wac_after_paise")
  /// What caused it: PURCHASE, ADJUSTMENT, TRANSFER, SUPPLIER_RETURN, WRITE_OFF (and INVOICE from Phase 2).
  refType         String     @map("ref_type")
  refId           String?    @map("ref_id") @db.Uuid
  reason          String?
  note            String?
  createdBy       String?    @map("created_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, branchId, productId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("stock_ledger")
}

/// Goods moving between two branches. Two steps: sent (leaves the first branch, in transit) then received (arrives at the
/// second). The cost travels with the goods.
model StockTransfer {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  fromBranchId String              @map("from_branch_id") @db.Uuid
  toBranchId   String              @map("to_branch_id") @db.Uuid
  status       TransferStatus      @default(IN_TRANSIT)
  note         String?
  createdBy    String?             @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  receivedBy   String?             @map("received_by") @db.Uuid
  receivedAt   DateTime?           @map("received_at") @db.Timestamptz()
  cancelledBy  String?             @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime?           @map("cancelled_at") @db.Timestamptz()
  lines        StockTransferLine[]

  @@index([tenantId, status])
  @@map("stock_transfers")
}

/// One slice of a transfer: a quantity of one product taken from one batch, with the value that travels with it.
model StockTransferLine {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  transferId String        @map("transfer_id") @db.Uuid
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  productId  String        @map("product_id") @db.Uuid
  qty        Int
  /// The value of these units at the sending branch's weighted average cost when they left, in paise.
  valuePaise BigInt        @map("value_paise")
  batchNo    String?       @map("batch_no")
  expiryDate DateTime?     @map("expiry_date") @db.Date

  @@index([tenantId, transferId])
  @@map("stock_transfer_lines")
}

/// Goods sent back to a supplier, with the debit note that records the credit the supplier owes.
model SupplierReturn {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  supplierId       String               @map("supplier_id") @db.Uuid
  supplier         Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// "DN-0001": the debit note number, counted per business.
  debitNoteNo      String               @map("debit_note_no")
  reason           String
  /// The credit the supplier gives for the goods, in paise (what the shop now owes them less).
  creditTotalPaise Int                  @map("credit_total_paise")
  note             String?
  createdBy        String?              @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  lines            SupplierReturnLine[]

  @@unique([tenantId, debitNoteNo])
  @@index([tenantId, supplierId])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  returnId        String         @map("return_id") @db.Uuid
  supplierReturn  SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  productId       String         @map("product_id") @db.Uuid
  batchId         String?        @map("batch_id") @db.Uuid
  qty             Int
  unitCreditPaise Int            @map("unit_credit_paise")
  creditPaise     Int            @map("credit_paise")
  /// What these units were worth in stock when they left, in paise. CONFIDENTIAL.
  costValuePaise  BigInt         @map("cost_value_paise")

  @@index([tenantId, returnId])
  @@map("supplier_return_lines")
}

/// "Tell me when this runs low": the quantity at or below which a product at a branch shows in the low-stock alerts.
model StockThreshold {
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  minQty    Int    @map("min_qty")

  @@id([branchId, productId])
  @@index([tenantId])
  @@map("stock_thresholds")
}

/// Remembers the answer to a request that carried an Idempotency-Key, so a retry (a double tap, a lost connection)
/// returns the SAME answer instead of doing the work twice.
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Which operation the key was used for, for example "purchase.create".
  scope          String
  key            String
  /// A fingerprint of the request body. The same key with a different body is a mistake, not a retry.
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([tenantId, scope, key])
  @@map("idempotency_keys")
}

/// A running number per business and kind of document ("DN" for debit notes), handed out without gaps or repeats.
model DocumentCounter {
  tenantId String @map("tenant_id") @db.Uuid
  kind     String
  nextNo   Int    @map("next_no")

  @@id([tenantId, kind])
  @@map("document_counters")
}

/// The tamper-evident chain over the audit log. Each audit row is "sealed" once: its hash covers its own content and the
/// previous seal's hash, so changing or removing any earlier row breaks every later hash. APPEND-ONLY.
model AuditChain {
  tenantId String   @map("tenant_id") @db.Uuid
  /// 1, 2, 3 ... in the order rows were sealed.
  seq      Int
  auditId  String   @unique @map("audit_id") @db.Uuid
  /// The previous seal's hash ("" for the first).
  prevHash String   @map("prev_hash")
  hash     String
  sealedAt DateTime @default(now()) @map("sealed_at") @db.Timestamptz()

  @@id([tenantId, seq])
  @@map("audit_chain")
}
