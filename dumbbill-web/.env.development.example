# DEV environment (your machine). Copy to `.env.development`; that file is private and never committed.
# Next.js loads `.env.development` automatically for `pnpm dev`.
#
# Variables starting with NEXT_PUBLIC_ are visible to anyone using the site (they are built into the
# browser code). NEVER put a secret in a NEXT_PUBLIC_ variable.

# Address of the Dumbbill API (the dumbbill-backend project, default port 3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Written on error reports so a problem can be matched to a release.
NEXT_PUBLIC_APP_VERSION=dev

# Error tracking: leave empty to switch Sentry off (nothing is sent anywhere).
NEXT_PUBLIC_SENTRY_DSN=
# Shows the design-system gallery at /design (every component and state). Keep it false on the live site.
NEXT_PUBLIC_DESIGN_GALLERY=true
