# PROD environment (the live site). Copy to `.env.production` on the build machine; never commit real values.
# Next.js loads `.env.production` for `pnpm build` / `pnpm start`.
# NEXT_PUBLIC_ values are baked into the browser code at BUILD time, so build again after changing them.

# Public address of the live API.
NEXT_PUBLIC_API_BASE_URL=https://api.dumbbill.in

# The release being built, for example the git tag.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Sentry project address for the web app (not secret, but project specific).
NEXT_PUBLIC_SENTRY_DSN=
# Shows the design-system gallery at /design (every component and state). Keep it false on the live site.
NEXT_PUBLIC_DESIGN_GALLERY=false
